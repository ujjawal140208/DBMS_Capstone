# Local development only. Copy this file to .env and add your Atlas credentials.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
DATABASE_NAME=caresphere_db
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUST_PROXY=0
# Only set DNS_SERVERS if your local network blocks Atlas SRV DNS queries.
# DNS_SERVERS=8.8.8.8,1.1.1.1
SEED_HOSPITALS=5
SEED_DOCTORS=1000
SEED_PATIENTS=50000
SEED_APPOINTMENTS=30000
SEED_BEDS_PER_HOSPITAL=16

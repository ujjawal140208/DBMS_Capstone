# MongoDB Atlas connection string (URL-encode special characters in the password)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
DATABASE_NAME=caresphere_db
PORT=8000
HOST=0.0.0.0
# Comma-separated exact frontend origins. Add your Vercel production URL when deploying.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUST_PROXY=0
# Optional: only set if your local DNS cannot resolve Atlas SRV records.
# DNS_SERVERS=8.8.8.8,1.1.1.1
# Synthetic demo data only; these do not affect the public hospital-directory importer.
SEED_HOSPITALS=5
SEED_DOCTORS=1000
SEED_PATIENTS=50000
SEED_APPOINTMENTS=30000

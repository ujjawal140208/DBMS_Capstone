# MongoDB Atlas (recommended). Replace user, password and cluster host.
# If the password has special characters (@ : / ? # %), URL-encode them (e.g. @ -> %40).
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
# Local MongoDB alternative (must be installed and running):
# MONGODB_URI=mongodb://127.0.0.1:27017
# If you get 'DNS lookup failed' / querySrv errors, uncomment to use public DNS:
# DNS_SERVERS=8.8.8.8,1.1.1.1
DATABASE_NAME=caresphere_db
PORT=8000
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to 1 only when running behind a reverse proxy / load balancer (Render, Railway, nginx...)
TRUST_PROXY=0
SEED_HOSPITALS=5
SEED_DOCTORS=1000
SEED_PATIENTS=50000
SEED_APPOINTMENTS=30000

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npm run build --prefix Frontend",
  "installCommand": "npm ci --include=optional --prefix Backend && npm ci --include=optional --prefix Frontend",
  "outputDirectory": "Frontend/dist",
  "functions": {
    "api/[...path].js": {
      "maxDuration": 30
    }
  }
}
